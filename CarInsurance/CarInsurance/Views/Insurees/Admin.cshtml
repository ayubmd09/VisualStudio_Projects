@model IEnumerable<CarInsurance.Models.Insuree>

@{
    ViewData["Title"] = "Admin";
}

<h1>Admin</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                First Name
            </th>
            <th>
                Last Name
            </th>
            <th>
                Email Address
            </th>
            <th>
                Quote
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.FirstName
                </td>
                <td>
                    @item.LastName
                </td>
                <td>
                    @item.EmailAddress
                </td>
                <td>
                    @item.Quote.ToString("C")
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-controller="Insurees" asp-action="Index">
        Back to Insurees
    </a>
</div>